# Copie para .env e preencha os valores.
# Nunca commite o arquivo .env no repositório.

# Segredo para assinar tokens de sessão (mín. 32 caracteres em produção)
VITE_SESSION_SECRET=altere-este-segredo-com-valor-longo-e-aleatorio

# Expiração do token de sessão em horas (padrão: 24)
VITE_SESSION_TTL_HOURS=24

# Usernames com papel admin (separados por vírgula)
VITE_ADMIN_USERS=admin

# URL base da API futura (queries parametrizadas — nunca concatenar SQL)
VITE_API_BASE_URL=
